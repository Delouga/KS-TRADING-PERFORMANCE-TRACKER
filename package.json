{
  "name": "forex-pro-trader-tracker",
  "productName": "Forex Pro Trader Tracker",
  "version": "1.0.0",
  "description": "Suivi de performance de trading (Track Record)",
  "author": "Kodjo",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.kodjo.forexprotradertracker",
    "productName": "Forex Pro Trader Tracker",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "src/**/*", "build/icon.png"],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Forex Pro Trader Tracker"
    }
  }
}
